# Multi-stage server image. The runtime stage is distroless and non-root.
# SNMP v3 links OpenSSL via snmp2; copy its runtime libraries explicitly.

FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev pkg-config protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
COPY --from=web /web/build ./web/build
RUN --mount=type=cache,id=kestrel-server-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=kestrel-server-target,target=/src/target \
    cargo build --locked --release -p kestrel-server -p kestrel-cli && \
    mkdir /runtime-data /out && cp target/release/kestrel-server target/release/kestrel /out/

FROM build AS ingest-benchmark
RUN --mount=type=cache,id=kestrel-server-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=kestrel-server-target,target=/src/target \
    cargo build --locked --release -p kestrel-server --example ingest_load && cp target/release/examples/ingest_load /out/
ENTRYPOINT ["/out/ingest_load"]

FROM gcr.io/distroless/cc-debian12
COPY --from=build /out/kestrel-server /kestrel-server
COPY --from=build /out/kestrel /kestrel
COPY --from=build /usr/lib/*-linux-gnu/libssl.so.3 /usr/lib/
COPY --from=build /usr/lib/*-linux-gnu/libcrypto.so.3 /usr/lib/
COPY --from=build --chown=65532:65532 /runtime-data /var/lib/kestrel
WORKDIR /var/lib/kestrel
USER nonroot:nonroot
EXPOSE 8443
ENTRYPOINT ["/kestrel-server"]
